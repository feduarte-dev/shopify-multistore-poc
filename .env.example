# Copy to .env and fill in. Never commit .env.
# One block per store in stores.json whose "mode" is "live".
# Variable names come from the store id: nyc-downtown -> SHOPIFY_NYC_DOWNTOWN_...

# Option 1 — Dev Dashboard app (2026+): client credentials, token refreshed automatically
SHOPIFY_NYC_DOWNTOWN_CLIENT_ID=
SHOPIFY_NYC_DOWNTOWN_CLIENT_SECRET=

# Option 2 — legacy custom app created before Jan 2026: static Admin API token
# SHOPIFY_NYC_DOWNTOWN_ACCESS_TOKEN=shpat_...

SHOPIFY_NYC_QUEENS_MALL_CLIENT_ID=
SHOPIFY_NYC_QUEENS_MALL_CLIENT_SECRET=

SHOPIFY_BOSTON_DOWNTOWN_CLIENT_ID=
SHOPIFY_BOSTON_DOWNTOWN_CLIENT_SECRET=

# Optional: Admin API version used for all live stores
# SHOPIFY_API_VERSION=2026-07
